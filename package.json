{
  "name": "@tweakly/multer-gcs-storage",
  "version": "1.1.0",
  "description": "A Google Cloud Storage (buckets) backend for multer",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
    "test": "c8 --100 ava"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tweakly/multer-gcs-storage.git"
  },
  "keywords": [
    "multer",
    "storage engine",
    "google cloud storage",
    "gcs",
    "gcp",
    "backend",
    "typescript"
  ],
  "author": "Lars Ivar Igesund",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tweakly/multer-gcs-storage/issues"
  },
  "homepage": "github.com/tweakly/multer-gcs-storage",
  "devDependencies": {
    "@septh/ts-run": "^2.2.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/urlencode": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "node-mocks-http": "^1.18.1",
    "testcontainers": "^12.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "urlencode": "^2.0.0",
    "uuid": "^14.0.1"
  },
  "peerDependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.3"
  },
  "files": [
    "dist/**",
    "src/**",
    "tsconfig.json"
  ],
  "ava": {
    "files": [
      "test/**/*.ts",
      "!test/utils/**"
    ],
    "extensions": [
      "ts",
      "mts"
    ]
  },
  "c8": {
    "exclude": [
      "test/**/*.ts",
      "src/gcp-specific.ts"
    ]
  },
  "packageManager": "pnpm@9.1.4+sha512.9df9cf27c91715646c7d675d1c9c8e41f6fce88246f1318c1aa6a1ed1aeb3c4f032fcdf4ba63cc69c4fe6d634279176b5358727d8f2cc1e65b65f43ce2f8bfb0"
}
